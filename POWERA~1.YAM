- htmlUploadFeatureBanner:
    Control: HtmlViewer
    Properties:
      HtmlText: ="<div style='font-family:Segoe UI,system-ui,sans-serif;background:#ffffff;border:1px solid #e3e8ef;border-left:4px solid #1f4e79;border-radius:10px;padding:0;overflow:hidden;box-sizing:border-box;width:100%'><div style='padding:16px 18px 14px'><div style='display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:8px'><span style='display:inline-block;background:#c6efce;color:#006100;font-size:10px;font-weight:700;letter-spacing:.8px;padding:3px 9px;border-radius:999px'>NEW</span><span style='font-size:16px;font-weight:600;color:#1a2233'>Bulk SIM inventory upload</span></div><div style='font-size:13px;color:#5b6779;line-height:1.55;margin-bottom:14px;max-width:70ch'> Export your country's inventory to Excel, edit as many rows as you like, and upload the file back. Every row is validated before anything is written to the list. </div><div style='display:flex;flex-wrap:wrap;gap:10px'><div style='flex:1 1 190px;background:#f7f9fc;border:1px solid #e3e8ef;border-radius:8px;padding:11px 13px;box-sizing:border-box'><div style='font-size:10px;font-weight:700;letter-spacing:.6px;color:#8a94a6;margin-bottom:3px'>STEP 1 — EXPORT</div><div style='font-size:12.5px;color:#1a2233;line-height:1.5'>Pick a country and download the workbook. It arrives with dropdowns and validation already built in.</div></div><div style='flex:1 1 190px;background:#f7f9fc;border:1px solid #e3e8ef;border-radius:8px;padding:11px 13px;box-sizing:border-box'><div style='font-size:10px;font-weight:700;letter-spacing:.6px;color:#8a94a6;margin-bottom:3px'>STEP 2 — EDIT</div><div style='font-size:12.5px;color:#1a2233;line-height:1.5'>Change existing rows or add new ones. Bad phone numbers and ICC_IDs turn red as you type.</div></div><div style='flex:1 1 190px;background:#f7f9fc;border:1px solid #e3e8ef;border-radius:8px;padding:11px 13px;box-sizing:border-box'><div style='font-size:10px;font-weight:700;letter-spacing:.6px;color:#8a94a6;margin-bottom:3px'>STEP 3 — UPLOAD</div><div style='font-size:12.5px;color:#1a2233;line-height:1.5'>Upload the file back. You get an emailed report showing exactly what was created, updated or rejected.</div></div></div><div style='display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:13px;padding-top:12px;border-top:1px solid #eef1f6;font-size:11.5px;color:#8a94a6'><span>Rows with errors are rejected individually — the rest still go through.</span><span>Re-uploading the same file is safe.</span></div></div></div>"
      X: =20
      Y: =20
      Width: =Parent.Width - 40
      Height: =If(Parent.Width < 700, 430, 265)
      AutoHeight: =false
      PaddingTop: =0
      PaddingBottom: =0
      PaddingLeft: =0
      PaddingRight: =0
      Size: =13
      Visible: =If(IsBlank(varShowUploadBanner), true, varShowUploadBanner)

- btnDismissUploadBanner:
    Control: Classic/Button
    Properties:
      Text: ="X"
      OnSelect: =Set(varShowUploadBanner, false)
      X: =htmlUploadFeatureBanner.X + htmlUploadFeatureBanner.Width - 34
      Y: =htmlUploadFeatureBanner.Y + 10
      Width: =24
      Height: =24
      Size: =11
      Color: =RGBA(138, 148, 166, 1)
      Fill: =RGBA(0, 0, 0, 0)
      HoverFill: =RGBA(238, 241, 246, 1)
      PressedFill: =RGBA(227, 232, 239, 1)
      BorderThickness: =0
      FocusedBorderThickness: =1
      Visible: =htmlUploadFeatureBanner.Visible
